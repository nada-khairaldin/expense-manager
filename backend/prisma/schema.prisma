
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     UserSettings?
  budgetCycles BudgetCycle[]
  categories   Category[]
  expenses     Expense[]
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  currency             String   @default("ILS")
  budgetRenewalDay     Int      @default(1)
  defaultBudgetAmount  Decimal? @db.Decimal(12, 2)
  budgetSetupCompleted Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BudgetCycle {
  id           String   @id @default(cuid())
  userId       String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  budgetAmount Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryBudgets CategoryBudget[]
  expenses        Expense[]

  @@unique([userId, startDate])
  @@index([userId, endDate])
}

model Category {
  id         String   @id @default(cuid())
  userId     String
  name       String
  icon       String?
  color        String?
  monthlyLimit Decimal? @db.Decimal(12, 2)
  isArchived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses        Expense[]
  categoryBudgets CategoryBudget[]

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model CategoryBudget {
  id             String  @id @default(cuid())
  budgetCycleId  String
  categoryId     String
  limitAmount    Decimal @db.Decimal(12, 2)

  budgetCycle BudgetCycle @relation(fields: [budgetCycleId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetCycleId, categoryId])
  @@index([categoryId])
}

model Expense {
  id                   String   @id @default(cuid())
  userId               String
  budgetCycleId        String
  categoryId           String?
  categoryNameSnapshot String
  description          String?
  amount               Decimal  @db.Decimal(12, 2)
  expenseDate          DateTime @db.Date
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCycle BudgetCycle @relation(fields: [budgetCycleId], references: [id], onDelete: Restrict)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, expenseDate])
  @@index([budgetCycleId, expenseDate])
  @@index([categoryId])
}
